<script>

function para(sayi) {
  return new Intl.NumberFormat(
    "tr-TR",
    {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }
  ).format(sayi) + " TL";
}

function yuzde(sayi) {
  return new Intl.NumberFormat(
    "tr-TR",
    {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }
  ).format(sayi);
}

function hesapla() {

  const tutarInput =
    document.getElementById("tutar");

  const oranInput =
    document.getElementById("oran");

  const sonuc =
    document.getElementById("sonuc");

  const tutar =
    Number(tutarInput.value);

  const oran =
    Number(oranInput.value);

  if (
    tutarInput.value === "" ||
    oranInput.value === "" ||
    !Number.isFinite(tutar) ||
    !Number.isFinite(oran) ||
    tutar <= 0 ||
    oran < 0 ||
    oran > 100
  ) {

    sonuc.innerHTML =
      "Lütfen geçerli bir tutar ve %0 ile %100 arasında komisyon oranı girin.";

    return;
  }

  const komisyon =
    tutar * oran / 100;

  const net =
    tutar - komisyon;

  sonuc.innerHTML =

    "<strong>Net Kalan: " +
    para(net) +
    "</strong>" +

    "<div class='result-detail'>" +

    "İşlem tutarı: " +
    para(tutar) +

    "<br>" +

    "Komisyon oranı: %" +
    yuzde(oran) +

    "<br>" +

    "Komisyon tutarı: " +
    para(komisyon) +

    "<br>" +

    "Komisyon sonrası net tutar: " +
    para(net) +

    "</div>";
}

document.getElementById("year").textContent =
  new Date().getFullYear();

</script>

</body>
</html>
